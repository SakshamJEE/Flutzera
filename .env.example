PORT=3000
# Public URL of the site, used for Stripe redirect URLs, canonical links and sitemap
BASE_URL=http://localhost:3000
# Stripe (https://dashboard.stripe.com/apikeys). Use sk_test_... while developing.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /api/stripe-webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Optional: Buttondown API key for the newsletter. Without it, sign-ups are stored in data/subscribers.jsonl
BUTTONDOWN_API_KEY=
